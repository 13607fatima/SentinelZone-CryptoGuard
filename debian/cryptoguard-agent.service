[Unit]
Description=SentinelZone CryptoGuard local agent
Requires=cryptoguard-collector.service
After=cryptoguard-collector.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=cryptoguard
Group=cryptoguard
ExecStart=/usr/lib/cryptoguard/cryptoguard-agent run --mode service --config /etc/cryptoguard/agent.json
Restart=on-failure
RestartSec=5
WatchdogSec=60
TimeoutStopSec=20
StateDirectory=cryptoguard
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=LD_LIBRARY_PATH=

[Install]
WantedBy=multi-user.target
