[Unit]
Description=SentinelZone CryptoGuard restricted read-only collector
PartOf=cryptoguard-agent.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=root
Group=cryptoguard
ExecStart=/usr/lib/cryptoguard/cryptoguard-agent collector --config /etc/cryptoguard/agent.json
Restart=on-failure
RestartSec=5
WatchdogSec=60
TimeoutStopSec=20
RuntimeDirectory=cryptoguard
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=no
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=~@mount @reboot @swap @module ptrace process_vm_writev
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=LD_LIBRARY_PATH=

[Install]
WantedBy=multi-user.target
